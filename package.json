{
	"name": "inialum-mail-service",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"dev": "npm-run-all --parallel dev:**",
		"dev:ses": "aws-ses-v2-local --port 8005",
		"dev:wrangler": "wrangler dev src/index.ts --port 8080",
		"deploy:production": "wrangler deploy --minify src/index.ts --keep-vars",
		"deploy:staging": "wrangler deploy --minify src/index.ts --keep-vars --env=staging",
		"create-token": "inialum-token-generator --service-name inialum-mail-service --env-file ./.dev.vars",
		"api:gen-schema": "openapi-typescript https://error-notification-api.inialum.org/schema/v1 -o ./src/types/generated/schema.d.ts",
		"lint": "biome check",
		"fix": "biome check --write",
		"test": "vitest run",
		"test:ci": "pnpm run test:coverage",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"gen:cf-types": "wrangler types --env-interface CloudflareBindings",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply inialum-mail-db --local",
		"db:migrate:staging": "wrangler d1 migrations apply inialum-mail-db-staging --remote --env staging",
		"db:migrate:prod": "wrangler d1 migrations apply inialum-mail-db --remote",
		"wrangler": "wrangler"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.684.0",
		"@hono/zod-openapi": "^0.16.4",
		"@inialum/error-notification-service-hono-middleware": "^0.5.0",
		"@inialum/error-notification-service-javascript-sdk": "^0.5.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"hono-idempotency": "^0.9.1",
		"libmime": "^5.4.2",
		"ulidx": "^2.4.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@inialum/token-generator": "^0.3.0",
		"@types/libmime": "^5.3.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"aws-sdk-client-mock": "^4.1.0",
		"aws-ses-v2-local": "^2.5.1",
		"drizzle-kit": "^0.31.7",
		"npm-run-all": "^4.1.5",
		"openapi-typescript": "^7.6.1",
		"type-fest": "^4.37.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.73.0"
	},
	"packageManager": "pnpm@10.6.1+sha512.40ee09af407fa9fbb5fbfb8e1cb40fbb74c0af0c3e10e9224d7b53c7658528615b2c92450e74cfad91e3a2dcafe3ce4050d80bda71d757756d2ce2b66213e9a3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
